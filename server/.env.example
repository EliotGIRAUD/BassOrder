# Copier vers .env pour le dév local :
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Unix)

# --- Dev local ---
BASSORDER_ALLOW_INSECURE_DEV=1
# Ou mieux : génère un secret ≥ 32 caractères
# BASSORDER_JWT_SECRET=remplace-par-un-secret-aleatoire-long-assez

BASSORDER_API_ADDR=127.0.0.1:8787
BASSORDER_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,https://tauri.localhost,http://tauri.localhost

# --- Prod (VPS) — ne jamais committer le vrai .env ---
# BASSORDER_ALLOW_INSECURE_DEV=   # laisser vide / absent
# BASSORDER_JWT_SECRET=          # openssl rand -hex 32
# BASSORDER_API_ADDR=127.0.0.1:8787
# BASSORDER_DB=/data/bassorder.db
# BASSORDER_PUBLIC_BASE=https://api.bassorder.smegg.cloud
# BASSORDER_CORS_ORIGINS=tauri://localhost,https://tauri.localhost,http://tauri.localhost,https://bassorder.smegg.cloud

# Pool knowledge : quorum anti-Sybil (défaut 2). Solo / tests : 1
# BASSORDER_POOL_MIN_VOTES=2
# Plafond likes pris en compte dans le poids pool (défaut 100)
# BASSORDER_LIKES_CAP=100
